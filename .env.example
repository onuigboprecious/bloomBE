# Server Configuration
PORT=8080
APP_ENV=production
FRONTEND_ORIGIN=https://www.enlazer.cloud

# PostgreSQL Database
POSTGRES_PASSWORD=MainInfarstructure
DATABASE_URL=postgres://postgres:MainInfarstructure@postgres:5432/nfc_db?sslmode=disable

# Resend API Key & Email Configuration
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL="Enlazer <onboarding@enlazer.cloud>"
RESEND_FROM="Enlazer <onboarding@enlazer.cloud>"
# Optional: If you created and published Templates in Resend Dashboard, put their Template IDs here
RESEND_WELCOME_TEMPLATE_ID=your_resend_welcome_template_id_here
RESEND_CARD_ACTIVATION_TEMPLATE_ID=your_resend_card_activation_template_id_here
RESEND_FORGOT_PASSWORD_TEMPLATE_ID=your_resend_forgot_password_template_id_here
RESEND_ORDER_SHIPPED_TEMPLATE_ID=your_resend_order_shipped_template_id_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://api.enlazer.cloud/api/auth/google/callback

# Paystack Integration Keys
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=enlazer-media
R2_PUBLIC_DOMAIN=https://media.enlazer.cloud

# Sentry Monitoring DSN
SENTRY_DSN=https://your_sentry_dsn_here

# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_secret_key
